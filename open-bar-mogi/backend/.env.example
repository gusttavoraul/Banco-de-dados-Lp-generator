# Porta da API
PORT=3333

# Conexão com o PostgreSQL (o docker-compose.yml na pasta acima sobe um banco com estes dados)
DATABASE_URL="postgresql://openbar:openbar@localhost:5432/openbar_mogi?schema=public"

# Segredo usado para assinar os tokens JWT. Gere um valor longo e aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Origens autorizadas a chamar a API (separe por vírgula)
CORS_ORIGIN="http://localhost:5173"

# Primeiro administrador, criado pelo `npm run db:seed`
ADMIN_NAME="Equipe Open Bar Mogi"
ADMIN_EMAIL="admin@openbarmogi.com.br"
ADMIN_PASSWORD="troque-esta-senha"
